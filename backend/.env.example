# Скопируйте в backend/.env и заполните значения.
# Закомментированные переменные необязательны: в комментарии указано значение по умолчанию.

# --- Сервер ---
PORT=
NODE_ENV=
# ENABLE_HTTPS=        # true — HTTPS в самом Node (обычно SSL терминирует nginx)
# HTTPS_PORT=          # по умолчанию PORT
# HTTP_PORT=           # порт редиректа HTTP → HTTPS
# SSL_KEY_PATH=        # по умолчанию backend/ssl/certificate.key
# SSL_CERT_PATH=       # по умолчанию backend/ssl/certificate.crt
# SSL_CA_PATH=         # по умолчанию backend/ssl/certificate_ca.crt или ca.crt

# --- База данных ---
MONGODB_URI=

# --- Авторизация ---
JWT_SECRET=
# Email-адреса администраторов через запятую
ADMIN_EMAILS=

# --- Почта (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# --- Оплата (Т-Банк) ---
TERMINAL_KEY=
TERMINAL_PASSWORD=

# --- Доставка: СДЭК ---
# Служба видна покупателям, только если заданы её ключи и она включена в админке.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Код города отправки; если задан CDEK_SHIPMENT_POINT, расчёт идёт из города этого ПВЗ.
CDEK_FROM_CITY_CODE=
CDEK_SHIPMENT_POINT=
# CDEK_TARIFF_TERMINAL=   # по умолчанию 136 (склад-склад)
# CDEK_TARIFF_DOOR=       # по умолчанию 137 (склад-дверь)
# CDEK_TEST=              # true — песочница api.edu.cdek.ru

# --- Доставка: Яндекс Доставка ---
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_STATION_ID=
# YANDEX_DELIVERY_TEST=   # true — тестовый контур

# --- Доставка: Ozon Доставка (Ozon Delivery API) ---
OZON_DELIVERY_CLIENT_ID=
OZON_DELIVERY_CLIENT_SECRET=
OZON_DELIVERY_SHIPMENT_METHOD_ID=
# Телефон магазина, зарегистрированный на Ozon (нужен для предварительного расчёта)
OZON_DELIVERY_ESTIMATE_PHONE=
